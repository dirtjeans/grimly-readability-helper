<?xml version="1.0" encoding="utf-8"?>
<!--
  nuget.org for everything public, plus ./nuget-local/ for the Aion Instruct
  Preview SDK (AionInstructPreview.Text.Framework.<ver>.nupkg), which ships
  via GitHub releases on microsoft/Aion-Instruct-Preview-Sample rather than
  a public feed during the developer preview. If Microsoft later publishes
  it to nuget.org, delete the local feed entry and the nuget-local folder.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="aion-instruct-preview-local" value="./nuget-local" />
  </packageSources>
</configuration>
