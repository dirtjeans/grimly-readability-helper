<Window x:Class="Grimly.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Grimly.Models"
        xmlns:converters="clr-namespace:Grimly.Converters"
        Title="Grimly Settings"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:ModelProviderKeyConverter x:Key="ProviderKey"/>

        <!-- Provider icon for the model list. Switches on the provider key
             derived from the model id. Microsoft-served models get drawn
             four-square marks (multicolor = Foundry Local, blue = the
             Windows AI on-device model); the third-party providers get
             recognizable glyphs. Drawn shapes + emoji keep this asset-free
             and theme-independent. -->
        <DataTemplate x:Key="ModelItemTemplate">
            <StackPanel Orientation="Horizontal">
                <ContentControl Width="14" Height="14" Margin="0,0,7,0"
                                VerticalAlignment="Center">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <!-- Default: Foundry Local (Microsoft squares) -->
                            <Setter Property="Content">
                                <Setter.Value>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/><ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Row="0" Grid.Column="0" Fill="#F25022" Margin="0,0,1,1"/>
                                        <Rectangle Grid.Row="0" Grid.Column="1" Fill="#7FBA00" Margin="1,0,0,1"/>
                                        <Rectangle Grid.Row="1" Grid.Column="0" Fill="#00A4EF" Margin="0,1,1,0"/>
                                        <Rectangle Grid.Row="1" Grid.Column="1" Fill="#FFB900" Margin="1,1,0,0"/>
                                    </Grid>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <!-- Windows AI (Aion on-device) — blue window panes -->
                                <DataTrigger Binding="{Binding Converter={StaticResource ProviderKey}}" Value="windows-ai">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/><RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/><ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Row="0" Grid.Column="0" Fill="#00A4EF" Margin="0,0,1,1"/>
                                                <Rectangle Grid.Row="0" Grid.Column="1" Fill="#00A4EF" Margin="1,0,0,1"/>
                                                <Rectangle Grid.Row="1" Grid.Column="0" Fill="#00A4EF" Margin="0,1,1,0"/>
                                                <Rectangle Grid.Row="1" Grid.Column="1" Fill="#00A4EF" Margin="1,1,0,0"/>
                                            </Grid>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <!-- Ollama — llama -->
                                <DataTrigger Binding="{Binding Converter={StaticResource ProviderKey}}" Value="ollama">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <TextBlock Text="🦙" FontSize="11" Margin="0"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <!-- LM Studio — purple badge -->
                                <DataTrigger Binding="{Binding Converter={StaticResource ProviderKey}}" Value="lmstudio">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <Border Background="#6E56CF" CornerRadius="3">
                                                <TextBlock Text="LM" FontSize="7" FontWeight="Bold"
                                                           Foreground="White" Margin="0"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <!-- GenieX — Qualcomm-style Q: circle with the
                                     signature tail drooping from the bottom
                                     right, in Qualcomm blue. -->
                                <DataTrigger Binding="{Binding Converter={StaticResource ProviderKey}}" Value="geniex">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <Grid>
                                                <Ellipse Stroke="#3253DC" StrokeThickness="2"
                                                         Margin="1,0,1,2"/>
                                                <Path Stroke="#3253DC" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M 8,10 Q 10,13 13,12"/>
                                            </Grid>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <TextBlock Text="{Binding}" Margin="0" FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BodyForegroundBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="4,4"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">

        <!-- Foundry Status -->
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Foundry Local:" FontWeight="SemiBold" Margin="0"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusIndicator" Margin="8,0,0,0"
                       VerticalAlignment="Center" FontSize="13">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}"/>
                        <Setter Property="Text" Value="{Binding FoundryStatus}"/>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>

        <!-- Foundry Endpoint (read-only, auto-detected) -->
        <TextBlock Text="Endpoint (auto-detected)" FontWeight="SemiBold"/>
        <TextBox Text="{Binding FoundryEndpoint}" IsReadOnly="True"
                 Background="{DynamicResource InputReadOnlyBackgroundBrush}" Foreground="{DynamicResource ReadOnlyForegroundBrush}"/>

        <!-- Model selector -->
        <DockPanel Margin="0,8,0,4">
            <TextBlock Text="Model" FontWeight="SemiBold" Margin="0"
                       VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Refresh"
                    Padding="8,2" FontSize="11" Margin="8,0,0,0"
                    HorizontalAlignment="Right"
                    Command="{Binding RefreshModelsCommand}"/>
        </DockPanel>
        <TextBox x:Name="ModelTextBox"
                 Text="{Binding ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource InputForegroundBrush}"
                 BorderBrush="{DynamicResource InputBorderBrush}" Padding="6,4" FontSize="13"/>
        <ListBox x:Name="ModelListBox"
                 ItemsSource="{Binding AvailableModels}"
                 ItemTemplate="{StaticResource ModelItemTemplate}"
                 Background="{DynamicResource ListBoxBackgroundBrush}" Foreground="{DynamicResource ListItemForegroundBrush}"
                 BorderBrush="{DynamicResource ListBoxBorderBrush}" BorderThickness="1"
                 MaxHeight="100" Margin="0,2,0,0"
                 FontSize="12"
                 SelectionChanged="ModelListBox_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="6,3"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Foreground" Value="{DynamicResource ListItemForegroundBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ListItemHoverForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ListItemSelectedBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ListItemSelectedForegroundBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,2,0,0"
                     Visibility="{Binding IsLoadingModels, Converter={StaticResource BoolToVis}}"/>

        <!-- Browse full catalog to download a model not currently cached. -->
        <TextBlock Margin="0,6,0,0">
            <Hyperlink Foreground="{DynamicResource AcceptButtonBackgroundBrush}"
                       Click="DownloadAnotherModel_Click">
                Download another model…
            </Hyperlink>
        </TextBlock>

        <!-- External-provider hint + one-click installs. Discovery adds
             Ollama / LM Studio / GenieX models automatically while those
             apps are running. The install links use winget (Ollama,
             LM Studio) or open the vendor site (GenieX — no winget pkg). -->
        <TextBlock Margin="0,2,0,0" FontSize="11" FontStyle="Italic"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   TextWrapping="Wrap"
                   Text="Ollama, LM Studio, and GenieX models appear here if running."/>
        <!-- Install row — only providers that AREN'T on this machine. -->
        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                    Visibility="{Binding ShowInstallRow, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Install:" FontSize="11" Margin="0,0,4,0"
                       Foreground="{DynamicResource MutedForegroundBrush}"/>
            <TextBlock FontSize="11" Margin="0,0,8,0"
                       Visibility="{Binding IsOllamaInstalled, Converter={StaticResource InverseBoolToVis}}">
                <Hyperlink Command="{Binding InstallProviderCommand}" CommandParameter="Ollama.Ollama"
                           Foreground="{DynamicResource AcceptButtonBackgroundBrush}">Ollama</Hyperlink>
            </TextBlock>
            <TextBlock FontSize="11" Margin="0,0,8,0"
                       Visibility="{Binding IsLmStudioInstalled, Converter={StaticResource InverseBoolToVis}}">
                <Hyperlink Command="{Binding InstallProviderCommand}" CommandParameter="ElementLabs.LMStudio"
                           Foreground="{DynamicResource AcceptButtonBackgroundBrush}">LM Studio</Hyperlink>
            </TextBlock>
            <TextBlock FontSize="11" Margin="0,0,8,0"
                       Visibility="{Binding IsGenieXInstalled, Converter={StaticResource InverseBoolToVis}}">
                <Hyperlink Command="{Binding OpenProviderSiteCommand}" CommandParameter="https://geniex.aihub.qualcomm.com/"
                           Foreground="{DynamicResource AcceptButtonBackgroundBrush}">GenieX (website)</Hyperlink>
            </TextBlock>
        </StackPanel>

        <!-- Start row — only providers that ARE installed. Clicking starts
             the server (if idle) and refreshes the model list. -->
        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                    Visibility="{Binding ShowStartRow, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Start:" FontSize="11" Margin="0,0,4,0"
                       Foreground="{DynamicResource MutedForegroundBrush}"/>
            <TextBlock FontSize="11" Margin="0,0,8,0"
                       Visibility="{Binding IsOllamaInstalled, Converter={StaticResource BoolToVis}}">
                <Hyperlink Command="{Binding StartProviderCommand}" CommandParameter="ollama"
                           Foreground="{DynamicResource AcceptButtonBackgroundBrush}">Ollama</Hyperlink>
            </TextBlock>
            <TextBlock FontSize="11" Margin="0,0,8,0"
                       Visibility="{Binding IsLmStudioInstalled, Converter={StaticResource BoolToVis}}">
                <Hyperlink Command="{Binding StartProviderCommand}" CommandParameter="lmstudio"
                           Foreground="{DynamicResource AcceptButtonBackgroundBrush}">LM Studio</Hyperlink>
            </TextBlock>
            <TextBlock FontSize="11" Margin="0,0,8,0"
                       Visibility="{Binding IsGenieXInstalled, Converter={StaticResource BoolToVis}}">
                <Hyperlink Command="{Binding StartProviderCommand}" CommandParameter="geniex"
                           Foreground="{DynamicResource AcceptButtonBackgroundBrush}">GenieX</Hyperlink>
            </TextBlock>
        </StackPanel>
        <TextBlock Margin="0,2,0,0" FontSize="11"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   TextWrapping="Wrap"
                   Text="{Binding ProviderInstallStatus}"/>

        <!-- Hotkey -->
        <TextBlock Text="Hotkey" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal">
            <TextBox Text="{Binding HotkeyModifiers}" Width="120" Margin="0,0,8,0"/>
            <TextBlock Text="+" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Text="{Binding HotkeyKey}" Width="60"/>
        </StackPanel>

        <TextBlock FontWeight="SemiBold">
            <Run Text="Creativity: "/>
            <Run Text="{Binding Creativity, StringFormat='{}{0:F1}', Mode=OneWay}"/>
            <Run Text=" " Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="11"/>
            <Run Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="11">
                <Run.Text>
                    <Binding Path="Creativity" StringFormat="{}">
                        <Binding.Converter>
                            <local:CreativityLabelConverter xmlns:local="clr-namespace:Grimly.Converters"/>
                        </Binding.Converter>
                    </Binding>
                </Run.Text>
            </Run>
        </TextBlock>
        <Slider Minimum="0" Maximum="1" Value="{Binding Creativity}"
                TickFrequency="0.1" IsSnapToTickEnabled="True"
                Foreground="{DynamicResource SliderForegroundBrush}"/>

        <DockPanel Margin="0,8,0,4">
            <TextBlock Text="Max Tokens" FontWeight="SemiBold" Margin="0"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding MaxTokensInfo}" Foreground="{DynamicResource SubtleForegroundBrush}"
                       FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBox Text="{Binding MaxTokens}"/>

        <TextBlock Text="{Binding PopupOpacity, StringFormat='Popup Opacity: {0:P0}'}" FontWeight="SemiBold"/>
        <Slider Minimum="0.5" Maximum="1" Value="{Binding PopupOpacity}"
                TickFrequency="0.05" IsSnapToTickEnabled="True"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Reset Defaults" Padding="12,6" Margin="0,0,8,0"
                    Command="{Binding ResetDefaultsCommand}"/>
            <Button Content="Save" Padding="16,6" Margin="0,0,8,0"
                    Command="{Binding SaveCommand}"
                    Background="{DynamicResource AcceptButtonBackgroundBrush}" Foreground="{DynamicResource AcceptButtonForegroundBrush}"/>
            <Button Content="Cancel" Padding="12,6"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
