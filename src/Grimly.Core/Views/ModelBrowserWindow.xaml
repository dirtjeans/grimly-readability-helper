<Window x:Class="Grimly.Views.ModelBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Grimly.Converters"
        Title="Download a model"
        Width="560" Height="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:ModelProviderKeyConverter x:Key="ProviderKey"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BodyForegroundBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0 header -->
            <RowDefinition Height="Auto"/>  <!-- 1 filter row -->
            <RowDefinition Height="*"/>     <!-- 2 list -->
            <RowDefinition Height="Auto"/>  <!-- 3 pull-by-name row -->
            <RowDefinition Height="Auto"/>  <!-- 4 error -->
            <RowDefinition Height="Auto"/>  <!-- 5 progress / status -->
            <RowDefinition Height="Auto"/>  <!-- 6 buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap"
                   Foreground="{DynamicResource SubtleForegroundBrush}"
                   Text="Pick a model. Foundry Local downloads can take several minutes on the first fetch; models already on this PC — cached, Windows AI, or served by Ollama, LM Studio, or GenieX — switch instantly."/>

        <!-- Search + NPU filter -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Background="{DynamicResource InputBackgroundBrush}"
                     Foreground="{DynamicResource InputForegroundBrush}"
                     BorderBrush="{DynamicResource InputBorderBrush}"
                     Padding="6,4" FontSize="13"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="NPU"
                          IsChecked="{Binding ShowNpu, Mode=TwoWay}"
                          Margin="10,0,0,0"
                          Foreground="{DynamicResource BodyForegroundBrush}"/>
                <CheckBox Content="GPU"
                          IsChecked="{Binding ShowGpu, Mode=TwoWay}"
                          Margin="10,0,0,0"
                          Foreground="{DynamicResource BodyForegroundBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Model list -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource InputBorderBrush}"
                BorderThickness="1" Background="{DynamicResource ListBoxBackgroundBrush}">
            <Grid>
                <ListBox ItemsSource="{Binding FilteredModels}"
                         SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource ListItemForegroundBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeDisplay}"
                                           Foreground="{DynamicResource SubtleForegroundBrush}"
                                           FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <Border DockPanel.Dock="Right" Padding="5,1" Margin="4,0,0,0"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource PillAppliedBackgroundBrush}"
                                        Visibility="{Binding IsCached, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="✓ cached" FontSize="10"
                                               Foreground="{DynamicResource PillAppliedForegroundBrush}"/>
                                </Border>
                                <Border DockPanel.Dock="Right" Padding="5,1" Margin="4,0,0,0"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource NeutralButtonBackgroundBrush}">
                                    <TextBlock Text="{Binding Device}" FontSize="10"
                                               Foreground="{DynamicResource NeutralButtonForegroundBrush}"/>
                                </Border>
                                <!-- Provider icon — same visual language as the
                                     Settings model picker. The converter accepts
                                     CatalogModelInfo directly. -->
                                <ContentControl Width="14" Height="14" Margin="0,0,7,0"
                                                VerticalAlignment="Center">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <!-- Default: Foundry Local (Microsoft squares) -->
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition/><RowDefinition/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/><ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>
                                                        <Rectangle Grid.Row="0" Grid.Column="0" Fill="#F25022" Margin="0,0,1,1"/>
                                                        <Rectangle Grid.Row="0" Grid.Column="1" Fill="#7FBA00" Margin="1,0,0,1"/>
                                                        <Rectangle Grid.Row="1" Grid.Column="0" Fill="#00A4EF" Margin="0,1,1,0"/>
                                                        <Rectangle Grid.Row="1" Grid.Column="1" Fill="#FFB900" Margin="1,1,0,0"/>
                                                    </Grid>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Converter={StaticResource ProviderKey}}" Value="windows-ai">
                                                    <Setter Property="Content">
                                                        <Setter.Value>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition/><RowDefinition/>
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition/><ColumnDefinition/>
                                                                </Grid.ColumnDefinitions>
                                                                <Rectangle Grid.Row="0" Grid.Column="0" Fill="#00A4EF" Margin="0,0,1,1"/>
                                                                <Rectangle Grid.Row="0" Grid.Column="1" Fill="#00A4EF" Margin="1,0,0,1"/>
                                                                <Rectangle Grid.Row="1" Grid.Column="0" Fill="#00A4EF" Margin="0,1,1,0"/>
                                                                <Rectangle Grid.Row="1" Grid.Column="1" Fill="#00A4EF" Margin="1,1,0,0"/>
                                                            </Grid>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Converter={StaticResource ProviderKey}}" Value="ollama">
                                                    <Setter Property="Content">
                                                        <Setter.Value>
                                                            <TextBlock Text="🦙" FontSize="11" Margin="0"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Converter={StaticResource ProviderKey}}" Value="lmstudio">
                                                    <Setter Property="Content">
                                                        <Setter.Value>
                                                            <Border Background="#6E56CF" CornerRadius="3">
                                                                <TextBlock Text="LM" FontSize="7" FontWeight="Bold"
                                                                           Foreground="White" Margin="0"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Converter={StaticResource ProviderKey}}" Value="geniex">
                                                    <Setter Property="Content">
                                                        <Setter.Value>
                                                            <Grid>
                                                                <Ellipse Stroke="#3253DC" StrokeThickness="2"
                                                                         Margin="1,0,1,2"/>
                                                                <Path Stroke="#3253DC" StrokeThickness="2"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                      Data="M 8,10 Q 10,13 13,12"/>
                                                            </Grid>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                                <TextBlock Text="{Binding Id}" VerticalAlignment="Center" FontSize="12"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Loading catalog…"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource SubtleForegroundBrush}"
                           FontStyle="Italic" FontSize="12"
                           Visibility="{Binding IsLoadingCatalog, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <!-- Error -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0"
                    Visibility="{Binding HasPullProviders, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Get more:" VerticalAlignment="Center" Margin="0,0,6,0"
                       Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="11"/>
            <ComboBox Width="110" VerticalAlignment="Center"
                      ItemsSource="{Binding PullProviders}"
                      SelectedItem="{Binding SelectedPullProvider, Mode=TwoWay}"
                      DisplayMemberPath="DisplayLabel"/>
            <TextBox Width="180" Margin="6,0,0,0" VerticalAlignment="Center" Padding="4,3"
                     Text="{Binding PullModelName, UpdateSourceTrigger=PropertyChanged}"
                     Background="{DynamicResource InputBackgroundBrush}"
                     Foreground="{DynamicResource InputForegroundBrush}"
                     BorderBrush="{DynamicResource InputBorderBrush}"
                     ToolTip="Model name as it appears in the provider's catalog"/>
            <Button Content="Pull" Margin="6,0,0,0" Padding="10,3" VerticalAlignment="Center"
                    Command="{Binding PullExternalCommand}"/>
            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11">
                <Hyperlink Command="{Binding OpenCatalogSiteCommand}"
                           Foreground="{DynamicResource AcceptButtonBackgroundBrush}">Browse catalog ↗</Hyperlink>
            </TextBlock>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource ErrorForegroundBrush}"
                   TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Progress -->
        <StackPanel Grid.Row="5" Margin="0,8,0,0"
                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
            <ProgressBar IsIndeterminate="True" Height="4"/>
            <TextBlock Text="{Binding DownloadStatus}"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       FontSize="11" Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Buttons -->
        <DockPanel Grid.Row="6" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Download"
                    Padding="14,4" FontSize="12"
                    Margin="6,0,0,0"
                    Background="{DynamicResource AcceptButtonBackgroundBrush}"
                    Foreground="{DynamicResource AcceptButtonForegroundBrush}"
                    Command="{Binding DownloadCommand}"
                    IsDefault="True">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedModel}" Value="{x:Null}">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button DockPanel.Dock="Right" Content="Cancel"
                    Padding="14,4" FontSize="12"
                    Background="{DynamicResource NeutralButtonBackgroundBrush}"
                    Foreground="{DynamicResource NeutralButtonForegroundBrush}"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"/>
        </DockPanel>
    </Grid>
</Window>
