<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows TFM (10.0.26100) for the CsWinRT projection used by the
         Aion Instruct on-device model client (WindowsAiClient). MinVersion
         stays 22621 (Windows 11 22H2) — the Aion path degrades gracefully
         to unavailable on older builds. -->
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Required by the [LibraryImport] source generator used for Win32
         P/Invoke (hotkey registration, UIA selection capture). No
         hand-written unsafe blocks exist anywhere in the codebase. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Grimly</RootNamespace>
    <AssemblyName>Grimly.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
    <PackageReference Include="WeCantSpell.Hunspell" Version="7.0.1" />
    <!-- Aion Instruct Preview — Microsoft's on-device language model
         (Copilot+ PCs, successor to Phi Silica; no LAF token required).
         The SDK nupkg comes from the repo-local nuget-local/ feed (see
         nuget.config); the runtime framework MSIX is installed separately
         on the user's machine. CsWinRT must be referenced explicitly for
         the WinRT projection source generator to run. -->
    <PackageReference Include="AionInstructPreview.Text.Framework" Version="1.0.*" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.1.5" />
  </ItemGroup>

  <!-- en_US Hunspell dictionary, embedded into the assembly so it ships
       inside the single-file exe with no external file dependency.
       Source: https://github.com/wooorm/dictionaries (MIT-licensed).
       Loaded at startup by SpellCheckerService. -->
  <ItemGroup>
    <EmbeddedResource Include="Dictionaries\en_US.aff" />
    <EmbeddedResource Include="Dictionaries\en_US.dic" />
    <EmbeddedResource Include="Dictionaries\proper_nouns.txt" />
  </ItemGroup>

  <!-- UI Automation (UIAutomationClient, UIAutomationTypes) is provided
       implicitly by the Microsoft.WindowsDesktop.App.WPF framework reference
       that UseWPF=true enables — no explicit Reference needed.
       Used by ClipboardService to read selected text directly from the
       target app's accessibility tree (no keystroke simulation). -->

</Project>
